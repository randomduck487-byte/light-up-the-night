local function strikeLightning()
    local startPos = camera.Focus.Position + Vector3.new(math.random(-300, 300), 600, math.random(-300, 300))
    local ray = Ray.new(startPos, Vector3.new(0, -1000, 0))
    local hitPart, hitPos = workspace:FindPartOnRayWithIgnoreList(ray, {puddleFolder})
    
    if not hitPart then return end

    local model = Instance.new("Model", workspace)
    local lastPos = startPos
    local distance = (camera.Focus.Position - hitPos).Magnitude
    
    task.spawn(function()
        local soundDelay = distance / 343
        task.wait(math.clamp(soundDelay, 0.05, 4.0))
        
        if #thunderClaps > 0 then
            local s = Instance.new("Sound", camera)
            s.SoundId = thunderClaps[math.random(1, #thunderClaps)]
            s.Volume = math.clamp(1.6 - (distance / 600), 0.35, 1.3)
            s.PlaybackSpeed = math.random(85, 110) / 100
            s:Play()
            Debris:AddItem(s, 8)
        end
    end)

    Lighting.Ambient = Color3.fromRGB(255, 120, 120)
    Lighting.FogColor = Color3.fromRGB(200, 60, 60)
    local atmo = Lighting:FindFirstChildOfClass("Atmosphere")
    if atmo then
        atmo.Color = Color3.fromRGB(220, 80, 80)
    end
    Lighting.Brightness = 3.0

    for i = 1, 12 do
        local nextPos = startPos:Lerp(hitPos, i/12) + Vector3.new(math.random(-12, 12), 0, math.random(-12, 12))
        if i == 12 then nextPos = hitPos end
        local beam = Instance.new("Part", model)
        beam.Anchored, beam.CanCollide = true, false
        beam.Material = Enum.Material.Neon
        beam.Color = Color3.fromRGB(255, 80, 80)
        beam.Size = Vector3.new(1.2, 1.2, (lastPos - nextPos).Magnitude + 1)
        beam.CFrame = CFrame.new(lastPos:Lerp(nextPos, 0.5), nextPos)
        lastPos = nextPos
    end

    task.spawn(function()
        task.wait(0.1)
        for i = 0, 1, 0.2 do
            Lighting.Brightness = 3.0 * (1 - i) + (0.85 * i)
            task.wait(0.03)
        end
        model:Destroy()
        resetLighting()
    end)
end

