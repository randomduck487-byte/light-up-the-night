-- 1. LONG-RANGE STRAPLIGHT ACCESSORY SYSTEM (Press F to Toggle)
local straplightOn = false
local nearLightPart = nil
local farLightPart = nil
local straplightConnection = nil

local toggleSound = Instance.new("Sound")
toggleSound.SoundId = "rbxassetid://12221976"
toggleSound.Volume = 0.6
toggleSound.Parent = SoundService

local function updateStraplight()
    local character = player.Character
    if not character then return end

    local accessory = character:FindFirstChild("StraplightAccessory")
    local handle = accessory and accessory:FindFirstChild("Handle")
    local hrp = character:FindFirstChild("HumanoidRootPart")
    local head = character:FindFirstChild("Head")

    local origin, direction
    if handle and hrp then
        local isFirstPerson = head and (camera.CFrame.Position - head.Position).Magnitude < 3
        direction = isFirstPerson and camera.CFrame.LookVector or hrp.CFrame.LookVector
        origin = handle.Position + (direction * 0.4)
    elseif hrp then
        origin = hrp.Position + Vector3.new(0, 1.2, 0)
        direction = hrp.CFrame.LookVector
    else
        return
    end

    if nearLightPart then
        nearLightPart.CFrame = CFrame.new(origin, origin + direction)
    end

    if farLightPart then
        local rayParams = RaycastParams.new()
        rayParams.FilterDescendantsInstances = {character, puddleFolder}
        rayParams.FilterType = Enum.RaycastFilterType.Exclude

        local hit = workspace:Raycast(origin, direction * 55, rayParams)
        if hit and hit.Distance < 12 then
            farLightPart.FlashSpotFar.Enabled = false
        else
            farLightPart.FlashSpotFar.Enabled = true
            local relayDist = hit and (hit.Distance - 5) or 45
            local farPos = origin + (direction * relayDist)
            farLightPart.CFrame = CFrame.new(farPos, farPos + direction)
        end
    end
end

local function setStraplightState(state)
    straplightOn = state
    toggleSound:Play()

    if straplightOn then
        if not nearLightPart then
            nearLightPart = Instance.new("Part")
            nearLightPart.Name = "StraplightNearAnchor"
            nearLightPart.Size = Vector3.new(0.2, 0.2, 0.2)
            nearLightPart.Transparency = 1
            nearLightPart.Anchored = true
            nearLightPart.CanCollide = false
            nearLightPart.Parent = puddleFolder

            local nearSpot = Instance.new("SpotLight")
            nearSpot.Name = "FlashSpotNear"
            nearSpot.Angle = 45
            nearSpot.Brightness = 30
            nearSpot.Range = 60
            nearSpot.Color = Color3.fromRGB(255, 25, 25)
            nearSpot.Shadows = true
            nearSpot.Enabled = true
            nearSpot.Parent = nearLightPart
        end

        if not farLightPart then
            farLightPart = Instance.new("Part")
            farLightPart.Name = "StraplightFarRelay"
            farLightPart.Size = Vector3.new(0.2, 0.2, 0.2)
            farLightPart.Transparency = 1
            farLightPart.Anchored = true
            farLightPart.CanCollide = false
            farLightPart.Parent = puddleFolder

            local farSpot = Instance.new("SpotLight")
            farSpot.Name = "FlashSpotFar"
            farSpot.Angle = 45
            farSpot.Brightness = 25
            farSpot.Range = 60
            farSpot.Color = Color3.fromRGB(255, 25, 25)
            farSpot.Shadows = true
            farSpot.Enabled = true
            farSpot.Parent = farLightPart
        end

        if not straplightConnection then
            straplightConnection = RunService.RenderStepped:Connect(updateStraplight)
        end
    else
        if straplightConnection then
            straplightConnection:Disconnect()
            straplightConnection = nil
        end
        if nearLightPart then
            nearLightPart:Destroy()
            nearLightPart = nil
        end
        if farLightPart then
            farLightPart:Destroy()
            farLightPart = nil
        end
    end
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
