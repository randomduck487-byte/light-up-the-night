-- 7. STAGGERED FADING PUDDLE SYSTEM
local function fadeInPuddle(decal)
    decal.Transparency = 1
    task.spawn(function()
        local fadeSpeed = math.random(30, 70) / 1000
        for t = 1, 0, -0.05 do
            if not decal.Parent then break end
            decal.Transparency = t
            task.wait(fadeSpeed)
        end
        decal.Transparency = 0
    end)
end

local function placeDecalOnSurface(hitPos, normal)
    local puddleSize = math.random(5, 11)

    local anchor = Instance.new("Part")
    anchor.Size = Vector3.new(puddleSize, 0.02, puddleSize)
    anchor.Transparency = 1
    anchor.CanCollide = false
    anchor.Anchored = true
    anchor.Parent = puddleFolder

    local decal = Instance.new("Decal")
    decal.Texture = PUDDLE_TEXTURE_ID
    decal.Transparency = 1
    decal.Parent = anchor

    if math.abs(normal.Y) > 0.9 then
        decal.Face = normal.Y > 0 and Enum.NormalId.Top or Enum.NormalId.Bottom
    elseif math.abs(normal.X) > 0.9 then
        decal.Face = normal.X > 0 and Enum.NormalId.Right or Enum.NormalId.Left
    else
        decal.Face = normal.Z > 0 and Enum.NormalId.Back or Enum.NormalId.Front
    end

    anchor.CFrame = CFrame.new(hitPos + (normal * 0.02)) * CFrame.Angles(0, math.rad(math.random(0, 360)), 0)
    
    fadeInPuddle(decal)
    return {anchor = anchor, decal = decal, pos = hitPos}
end

local function spawnOrRecyclePuddle(targetPos)
    local camPos = camera.Focus.Position

    local rayParams = RaycastParams.new()
    rayParams.FilterDescendantsInstances = {player.Character, puddleFolder}
    rayParams.FilterType = Enum.RaycastFilterType.Exclude

    local ray = workspace:Raycast(targetPos + Vector3.new(0, 150, 0), Vector3.new(0, -300, 0), rayParams)
    if not ray then return end

    for _, item in ipairs(activePuddles) do
        if (item.pos - camPos).Magnitude > MAX_PLAYER_DIST then
            item.anchor:Destroy()
            local newItem = placeDecalOnSurface(ray.Position, ray.Normal)
            item.anchor = newItem.anchor
            item.decal = newItem.decal
            item.pos = ray.Position
            return
        end
    end

    if #activePuddles < MAX_PUDDLES then
        local newItem = placeDecalOnSurface(ray.Position, ray.Normal)
        table.insert(activePuddles, newItem)
    end
end

