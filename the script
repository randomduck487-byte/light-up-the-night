-- Function to apply and lock the custom skybox permanently
local function applySkybox()
	for _, child in ipairs(Lighting:GetChildren()) do
		if child:IsA("Sky") and child.Name ~= "ULTRAKILL_7_2_Sky" then
			child:Destroy()
		end
	end

	local sky = Lighting:FindFirstChild("ULTRAKILL_7_2_Sky")
	if not sky then
		sky = Instance.new("Sky")
		sky.Name = "ULTRAKILL_7_2_Sky"
		sky.CelestialBodiesShown = false
		sky.Parent = Lighting
	end

	sky.SkyboxRt = wall7_2     -- East (+X)
	sky.SkyboxLf = bgViolence  -- West (-X)
	sky.SkyboxFt = bgViolence  -- North (-Z)
	sky.SkyboxBk = bgViolence  -- South (+Z)
	sky.SkyboxUp = bgViolence  -- Up (+Y)
	sky.SkyboxDn = bgViolence  -- Down (-Y)
end

applySkybox()

Lighting.ChildAdded:Connect(function(child)
	if child:IsA("Sky") and child.Name ~= "ULTRAKILL_7_2_Sky" then
		child:Destroy()
		applySkybox()
	end
end)

Lighting.ChildRemoved:Connect(function(child)
	if child.Name == "ULTRAKILL_7_2_Sky" then
